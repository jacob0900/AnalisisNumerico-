import numpy as np

def lu(A):
    A = np.array(A, dtype=float)
    n = len(A)
    L = np.zeros((n, n))
    U = np.zeros((n, n))
    
    for i in range(n):
        for j in range(i, n):
            suma = sum(L[i, k] * U[k, j] for k in range(i))
            U[i, j] = A[i, j] - suma
        
        L[i, i] = 1.0
        
        if abs(U[i, i]) < 1e-10:
            raise ValueError(f"Pivot cero en posición ({i},{i})")
        
        for j in range(i + 1, n):
            suma = sum(L[j, k] * U[k, i] for k in range(i))
            L[j, i] = (A[j, i] - suma) / U[i, i]
    
    return L, U


def forward_substitution(L, b):
    n = len(b)
    y = np.zeros(n)
    for i in range(n):
        y[i] = b[i] - sum(L[i, k] * y[k] for k in range(i))
    return y


def backward_substitution(U, y):
    n = len(y)
    x = np.zeros(n)
    for i in range(n - 1, -1, -1):
        x[i] = (y[i] - sum(U[i, k] * x[k] for k in range(i + 1, n))) / U[i, i]
    return x


def solve(A, b):
    L, U = lu(A)
    y = forward_substitution(L, b)
    x = backward_substitution(U, y)
    return x


if __name__ == "__main__":
    A = np.array([
        [4, 3, 2],
        [6, 3, 5],
        [2, 1, 3]
    ], dtype=float)
    
    L, U = lu(A)
    
    print("L:")
    print(L)
    print("\nU:")
    print(U)
    print("\nA = L·U:")
    print(L @ U)
    
    b = np.array([1, 2, 3], dtype=float)
    x = solve(A, b)
    
    print("\nSolución x:")
    print(x)
    print("\nVerificación A·x:")
    print(A @ x)


    